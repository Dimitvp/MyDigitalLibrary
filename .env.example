POSTGRES_DB=mydigitallibrary
POSTGRES_USER=mydigitallibrary
POSTGRES_PASSWORD=changeme

# Development-only seed admin (plan section 8). Never a real secret here —
# this file is committed. Set a real password only in your local, gitignored .env.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Optional (plan section 5.3) — Google Books works unauthenticated at low
# volumes, but shares a rate limit across every anonymous caller. Leave blank
# to rely on that; set a real key here only in your local, gitignored .env.
GOOGLE_BOOKS_API_KEY=
