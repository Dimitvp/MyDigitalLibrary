# Copy to /opt/biblioteka/.env.production on the server (chmod 600). Fill in
# real values there — this example file stays committed with placeholders only.

POSTGRES_DB=mydigitallibrary
POSTGRES_USER=mydigitallibrary
POSTGRES_PASSWORD=

# The one account this app has. IMPORTANT: a real, strong password here —
# NOT the local-dev default from .env.example ("ChangeMe123!" is public in
# this repo's history). Runs in every environment now (see
# .claude/history/2026-09-17-1400-pre-deploy-security-hardening.md), so this
# is what actually creates the login once the site is live.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Optional — same as local dev, leave blank to rely on Google Books' shared
# unauthenticated rate limit.
GOOGLE_BOOKS_API_KEY=
